RALLY_DATABASE_PATH=data/rally.sqlite3
RALLY_APP_URL=http://127.0.0.1:8000
RALLY_PORTAL_PUBLISH_APPROVED=0
RALLY_HISTORY_ENABLED=1
RALLY_WEBHOOK_TOKEN=replace-with-a-random-secret
RALLY_ALLOWED_CHAT_GUIDS=
RALLY_BLUEBUBBLES_URL=http://127.0.0.1:1234
RALLY_BLUEBUBBLES_PASSWORD=replace-with-bluebubbles-server-password
RALLY_XAI_API_KEY=replace-with-xai-key
RALLY_GROK_MODEL=grok-4.7
# Ordinary addressed replies use a separate Grok model; extraction stays on RALLY_GROK_MODEL.
RALLY_GROK_REPLY_MODEL=grok-4.3
RALLY_GROK_REPLY_REASONING_EFFORT=none
RALLY_GROK_REPLY_TIMEOUT=25
# Image and short-clip generation (xAI Imagine). Same RALLY_XAI_API_KEY.
RALLY_GROK_IMAGE_MODEL=grok-imagine-image-2.0
RALLY_GROK_VIDEO_MODEL=grok-imagine-video-1.5
# Extraction can take longer than conversation decisions (4 seconds). Range: 1–120 seconds.
RALLY_GROK_EXTRACTION_TIMEOUT=60
RALLY_EXTRACTION_PROVIDER=grok
RALLY_META_MODEL_API_KEY=
RALLY_GEOAPIFY_API_KEY=replace-with-free-geoapify-key
RALLY_DEFAULT_CITY="New York, NY"
RALLY_TIME_ZONE=America/New_York
RALLY_STALL_MINUTES=30
RALLY_TICK_SECONDS=60
RALLY_MAX_PLACE_REQUESTS=100
RALLY_DEMO_MODE=0
RALLY_DEMO_VENUES=0
RALLY_CALENDAR_ENABLED=0
RALLY_GOOGLE_CLIENT_ID=
RALLY_GOOGLE_CLIENT_SECRET=
RALLY_GOOGLE_REFRESH_TOKEN=
RALLY_GOOGLE_CALENDAR_ID=
RALLY_MAX_CALENDAR_REQUESTS=20
# Read-only public web search for directly addressed Rally requests (xAI Responses API).
# Searches use the current request and local tone label, never surrounding chat history.
RALLY_WEB_ENABLED=0
RALLY_WEB_DAILY_LIMIT=0
RALLY_ADAPTIVE_ENABLED=1
RALLY_ADAPTIVE_CODE_PROPOSALS=1
RALLY_ADMIN_TOKEN=
RALLY_GROK_EXTRACTION_EFFORT=low
RALLY_WEB_MAX_TOOL_CALLS=3
# Browser voice relationship check-in (Grok Voice). Requires RALLY_ADMIN_TOKEN and
# RALLY_XAI_API_KEY above. See docs/voice.md.
RALLY_VOICE_ENABLED=0
RALLY_VOICE_OWNER=local-imessage-account
RALLY_VOICE_MODEL=grok-voice-latest
# Outbound restaurant calls (Grok Voice + Twilio PSTN). Without these, the
# chat command still runs a local loopback and never claims a real booking.
# See docs/voice.md. Do not put secrets in chat.
RALLY_TWILIO_ACCOUNT_SID=
RALLY_TWILIO_AUTH_TOKEN=
RALLY_TWILIO_FROM_NUMBER=
RALLY_CALLBACK_NUMBER=
# Mac Continuity fallback (open tel: / FaceTime audio) when Twilio is unset.
# The dialer only opens the authorized connectivity-test number. Default on.
RALLY_CONTINUITY_DIAL=1
# Optional local Chromium browser. Allowlisted Rally chats can search, browse,
# and walk reservations up to a human confirm on this Mac. See docs/browser.md.
# RALLY_BROWSER_OWNER_CHAT_ID=iMessage;-;+15555550100
# RALLY_BROWSER_OWNER_SENDER_ID=local-imessage-account
RALLY_BROWSER_ENABLED=0
# DEBUG logs on logger rally.browser (launch, tool calls, recover, tracebacks).
RALLY_BROWSER_DEBUG=0
RALLY_BROWSER_OWNER_CHAT_ID=
RALLY_BROWSER_OWNER_SENDER_ID=
# Generate independently from RALLY_ADMIN_TOKEN: python -c 'import secrets; print(secrets.token_urlsafe(32))'
RALLY_BROWSER_ADMIN_TOKEN=
RALLY_BROWSER_PROFILE_PATH=data/browser/profile
RALLY_BROWSER_DOWNLOAD_PATH=data/browser/downloads
RALLY_BROWSER_MAX_ACTIONS=6
RALLY_BROWSER_MAX_TEXT_CHARS=6000
# Browser Use Cloud agent (preferred). Plans clicks/types/extracts. Stealth/CAPTCHA
# is the vendor's problem. Also accepts BROWSER_USE_API_KEY.
RALLY_BROWSER_USE_API_KEY=
# Optional Browserbase stealth CDP for the local Grok planner fallback.
# Also accepts BROWSERBASE_API_KEY / BROWSERBASE_PROJECT_ID.
RALLY_BROWSERBASE_API_KEY=
RALLY_BROWSERBASE_PROJECT_ID=
