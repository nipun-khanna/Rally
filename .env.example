RALLY_DATABASE_PATH=data/rally.sqlite3
RALLY_APP_URL=http://127.0.0.1:8000
RALLY_PORTAL_PUBLISH_APPROVED=0
RALLY_HISTORY_ENABLED=1
RALLY_WEBHOOK_TOKEN=replace-with-a-random-secret
RALLY_ALLOWED_CHAT_GUIDS=
RALLY_BLUEBUBBLES_URL=http://127.0.0.1:1234
RALLY_BLUEBUBBLES_PASSWORD=replace-with-bluebubbles-server-password
RALLY_XAI_API_KEY=replace-with-xai-key
RALLY_GROK_MODEL=grok-4.7
# Extraction can take longer than direct replies (25 seconds). Range: 1–120 seconds.
RALLY_GROK_EXTRACTION_TIMEOUT=60
RALLY_EXTRACTION_PROVIDER=grok
RALLY_META_MODEL_API_KEY=
RALLY_GEOAPIFY_API_KEY=replace-with-free-geoapify-key
RALLY_DEFAULT_CITY="New York, NY"
RALLY_TIME_ZONE=America/New_York
RALLY_STALL_MINUTES=30
RALLY_TICK_SECONDS=60
RALLY_MAX_PLACE_REQUESTS=100
RALLY_DEMO_MODE=0
RALLY_DEMO_VENUES=0
RALLY_CALENDAR_ENABLED=0
RALLY_GOOGLE_CLIENT_ID=
RALLY_GOOGLE_CLIENT_SECRET=
RALLY_GOOGLE_REFRESH_TOKEN=
RALLY_GOOGLE_CALENDAR_ID=
RALLY_MAX_CALENDAR_REQUESTS=20
# Read-only public web search for directly addressed Rally requests (xAI Responses API).
# Searches use the current request and local tone label, never surrounding chat history.
RALLY_WEB_ENABLED=0
RALLY_WEB_DAILY_LIMIT=0
RALLY_WEB_MAX_TOOL_CALLS=3
